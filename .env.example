# Copy to .env and fill in. Never commit the real .env -- it is gitignored.
#   cp .env.example .env

# ---------- Core ----------
# openssl rand -hex 32
JWT_SECRET=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this after go-live makes previously encrypted values unreadable.
FERNET_KEY=

DB_NAME=mytaman
CORS_ORIGINS=*
APP_PORT=3000

# ---------- AI ----------
# Optional deploy-time keys, used only for a provider that has no key saved in the
# Model Router UI yet -- a key saved there always takes priority over these. A provider
# with no key from either source is skipped by the router's failover, so configuring one
# provider is enough; there is no shared cross-provider key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Email (parent-approval links) ----------
# Leave SMTP_HOST blank to keep console mode: no mail is sent and the approval
# link is printed to the backend log (`docker compose logs backend`). The signup
# flow works either way -- only delivery differs.
#
# Gmail: SMTP_PASSWORD must be a 16-character App Password, not your normal
# password, and the account needs 2-Step Verification enabled.
#   https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lv99.ai <no-reply@mytaman.ai>
SMTP_STARTTLS=true

# The address a PARENT'S BROWSER can reach -- this is what the emailed approval
# link points at, so localhost will not work for a real recipient.
# e.g. http://172.197.216.32:3000  or  https://tutor.yourdomain.com
APP_BASE_URL=http://localhost:3000
